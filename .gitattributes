# Byte-pinned release patches and lockfiles must survive Windows checkout intact.
* text=auto eol=lf
*.patch text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.mjs text eol=lf
*.ps1 text eol=lf
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.zip binary
*.exe binary
*.dll binary
