+      cwd: projectRoot,
+      env,
+      encoding: 'utf8',
+    });
+  }
+  return spawnSync('bash', [script, ...paths], { cwd: projectRoot, env, encoding: 'utf8' });
+}
+
 function readProjectFile(path: string): string {
   return readFileSync(resolve(projectRoot, path), 'utf8');
 }
