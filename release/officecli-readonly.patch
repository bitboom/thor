-        return set;
+    }
+
+    private bool IsThorReadOnlyRequestAllowed(string requestLine, Dictionary<string, string> headers)
+    {
+        var parts = requestLine.Split(' ', StringSplitOptions.RemoveEmptyEntries);
+        if (parts.Length != 3 || parts[0] != "GET" ||
+            (parts[1] != "/" && parts[1] != "/events"))
+            return false;
+        if (headers.ContainsKey("Upgrade")) return false;
+        if (headers.TryGetValue("Connection", out var connection) &&
+            connection.Split(',').Any(value => value.Trim().Equals("upgrade", StringComparison.OrdinalIgnoreCase)))
+            return false;
+        if (!headers.TryGetValue("Origin", out var origin)) return true;
+        // Origins are scheme+host+port. A different localhost port is not this
+        // preview's origin; opaque file/data origins must also fail closed.
+        return Uri.TryCreate(origin, UriKind.Absolute, out var uri) &&
+            uri.Scheme == "http" && uri.Port == _port &&
+            string.IsNullOrEmpty(uri.UserInfo) && uri.AbsolutePath == "/" &&
+            string.IsNullOrEmpty(uri.Query) && string.IsNullOrEmpty(uri.Fragment) &&
+            _allowedHosts.Contains(uri.Host);
     }
 
     /// <summary>Strip the optional <c>:port</c> from a Host header value, preserving bracketed IPv6.</summary>
