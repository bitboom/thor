     private static HashSet<string> BuildAllowedHosts()
     {
-        var set = new HashSet<string>(StringComparer.OrdinalIgnoreCase)
+        return new HashSet<string>(StringComparer.OrdinalIgnoreCase)
         { "localhost", "127.0.0.1", "[::1]", "::1" };
